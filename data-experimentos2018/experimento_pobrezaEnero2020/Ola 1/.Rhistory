dim(pilot0819) # N=1580
# Introduccion
# 1 es aceptar; 2 es no aceptar
table(pilot0819$Intro,exclude=NULL) # (2) 136 no aceptan, (1) 1444 aceptan
table(pilot0819$Intro,pilot0819$Finished,exclude=NULL) # Esta OK.
pilot0819 <- filter(pilot0819,Intro==1)
dim(pilot0819) # N=1444
pilot0819$tratamiento=NA
pilot0819$tratamiento[pilot0819$FL_9_DO_Control==1]=0
pilot0819$tratamiento[pilot0819$FL_9_DO_Tratamiento==1]=1
pilot0819$tratamiento[pilot0819$FL_9_DO_Tratamiento_desigualdad==1]=2
table(pilot0819$tratamiento,exclude=NULL)
# Familia
pilot0819$Mfamilia=pilot0819$get_ah_1
pilot0819$Mfamilia[pilot0819$get_ah_1==-99]=NA
table(pilot0819$Mfamilia,pilot0819$get_ah_1,exclude=NULL)
pilot0819$Mfamilia=as.numeric(pilot0819$Mfamilia)
str(pilot0819$Mfamilia)
margin.table(table(pilot0819$Mfamilia)) # Responden: 914
prop.table(table(pilot0819$Mfamilia))
# Educacion padres
pilot0819$MeducacionP=pilot0819$get_ah_2
pilot0819$MeducacionP[pilot0819$get_ah_2==-99]=NA
table(pilot0819$MeducacionP,pilot0819$get_ah_2,exclude=NULL)
pilot0819$MeducacionP=as.numeric(pilot0819$MeducacionP)
str(pilot0819$MeducacionP)
margin.table(table(pilot0819$MeducacionP)) # Responden: 914
prop.table(table(pilot0819$MeducacionP))
prop.table(wtd.table(cep$edpar,weights = cep$FACTOR))
# Educacion padres
pilot0819$MeducacionP=pilot0819$get_ah_2
pilot0819$MeducacionP[pilot0819$get_ah_2==-99]=NA
table(pilot0819$MeducacionP,pilot0819$get_ah_2,exclude=NULL)
pilot0819$MeducacionP=as.numeric(pilot0819$MeducacionP)
str(pilot0819$MeducacionP)
margin.table(table(pilot0819$MeducacionP)) # Responden: 914
# Educacion
pilot0819$Meducacion=pilot0819$get_ah_3
pilot0819$Meducacion[pilot0819$get_ah_3==-99]=NA
table(pilot0819$Meducacion,pilot0819$get_ah_3,exclude=NULL)
pilot0819$Meducacion=as.numeric(pilot0819$Meducacion)
str(pilot0819$Meducacion)
margin.table(table(pilot0819$Meducacion)) # Responden: 914
# Ambicion
pilot0819$Mambicion=pilot0819$get_ah_4
pilot0819$Mambicion[pilot0819$get_ah_4==-99]=NA
table(pilot0819$Mambicion,pilot0819$get_ah_4,exclude=NULL)
pilot0819$Mambicion=as.numeric(pilot0819$Mambicion)
str(pilot0819$Mambicion)
margin.table(table(pilot0819$Mambicion)) # Responden: 914
# Trabajo
pilot0819$Mtrabajo=pilot0819$get_ah_5
pilot0819$Mtrabajo[pilot0819$get_ah_5==-99]=NA
table(pilot0819$Mtrabajo,pilot0819$get_ah_5,exclude=NULL)
pilot0819$Mtrabajo=as.numeric(pilot0819$Mtrabajo)
str(pilot0819$Mtrabajo)
margin.table(table(pilot0819$Mtrabajo)) # Responden: 914
pilot0819b <- filter(pilot0819,tratamiento==0 | tratamiento==1 | tratamiento==2)
dim(pilot0819b) # N=949
# Variables de oportunidades: no estandarizados
##################################
m1 <- lm(Mfamilia ~ factor(tratamiento), data = pilot0819b)
m2 <- lm(MeducacionP ~ factor(tratamiento), data = pilot0819b)
m3 <- lm(Meducacion ~ factor(tratamiento), data = pilot0819b)
m4 <- lm(Mambicion ~ factor(tratamiento), data = pilot0819b)
m5 <- lm(Mtrabajo ~ factor(tratamiento), data = pilot0819b)
m1 <- coeftest(m1,vcovHC(m1, typt="HC2"))
m2 <- coeftest(m2,vcovHC(m2, typt="HC2"))
m3 <- coeftest(m3,vcovHC(m3, typt="HC2"))
m4 <- coeftest(m4,vcovHC(m4, typt="HC2"))
m5 <- coeftest(m5,vcovHC(m5, typt="HC2"))
screenreg(l=list(m1,m2), single.row = TRUE, stars = c(0.01, 0.05, 0.10))
screenreg(l=list(m3,m4,m5), single.row = TRUE, stars = c(0.01, 0.05, 0.10))
