cateGw3 <- data.frame(
stringsAsFactors = FALSE,
tratamiento = c("Poverty","Poverty","Poverty",
"Poverty","Inequality","Inequality","Inequality",
"Inequality"),
variable = c("Lower","Upper",
"Inegalitarian","Egalitarian","Lower","Upper","Inegalitarian",
"Egalitarian"),
ate = c(0.2535,-0.03,0.0289,0.0794,
0.2191,0.0076,0.0435,0.1088),
low = c(0.0379,-0.1689,-0.1243,
-0.096,0.0074,-0.1373,-0.1093,-0.0768),
high = c(0.4691,0.1089,0.1822,0.2548,
0.4307,0.1525,0.1963,0.2945)
)
cateGw3
ggplot(data=cateGw3,
aes(x=tratamiento,y=ate,group=variable, color=variable)) +
geom_point(aes(shape=variable), size=4, position=pd) +
scale_y_continuous(limits=c(-0.20,0.50), breaks=seq(-0.20,0.50, by=.05),labels=scaleFUN) +
scale_color_manual(name="Outcome",
values=c("coral","steelblue","red","black")) +
scale_shape_manual(name="Outcome",values=c(17,19,18,15)) +
theme_bw() +
geom_errorbar(aes(ymin=low,ymax=high),width=0.1,position=pd) +
geom_hline(yintercept = 0, linetype = "dashed") +
labs(x="Treatment", y="CATE") +
ggtitle("Conditional Average Treatment Effects (CATE)") + theme(plot.title = element_text(hjust = 0.5))
