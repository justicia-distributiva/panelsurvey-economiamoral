pOri
pWork
m3 <- lm_robust(zdvE2~factor(tratamiento)+
factor(sexoW)+edadW+factor(edcepWB)+factor(estlabB)+factor(ingresosQ)+factor(comuna_w1C)+
get_ah_1_w1+get_ah_2_w1+factor(ideo),data=wide12)
m3 <- tidy(m3)
pIndex <- m3$p.value[2:3]
pIndex
# Generamos 50 test estadisticos. Piense en, por ejemplo, 50 ts de student
# La mitad son generados a partir de distribucion normal con media 0
# La otra mitad son generados a partir de una distribucion normal con media 3
x <- rnorm(50, mean = c(rep(0, 25), rep(3, 25)))
# Obtenemos 50 valores p
p <- round(2*pnorm(sort(-abs(x))), 3)
p
# Elegimos el valor de alpha
alpha <- 0.05
# Test significativos sin correcciom
sig <- p < alpha
# Test signficativos con correccion de Bonferroni (funcion de R p.adjust)
bonferroni_sig <- p.adjust(p, "bonferroni") < alpha
# Comparamos
sig
bonferroni_sig
pOri
pWork
pIndex
p <- (0.008801584,0.004815380,0.54767770,0.01713801,0.1416409,0.9830031)
p <- c(0.008801584,0.004815380,0.54767770,0.01713801,0.1416409,0.9830031)
p
# Correcion comparaciones multiples
sig <- p < alpha # sin correccion
sig
bonferroni_sig <- p.adjust(p, "bonferroni") < alpha # con correccion
bonferroni_sig
BH_sig <- p.adjust(p, "BH") <alpha # con correcion
bonferroni_sig
BH_sig
holm_sig <- p.adjust(p, "holm") < alpha # con correccion
holm_sig
