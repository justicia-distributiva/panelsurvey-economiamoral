wide12In <- dplyr::select(wide12,ingresosQb,tratamiento)
wide12In <- na.omit(wide12In)
summary(wide12In)
wide12In %>%
group_by(tratamiento) %>%
summarise(mean=mean(ingresosQb),n=n())
summary(lm(ingresosQb~factor(tratamiento),data=wide12))
