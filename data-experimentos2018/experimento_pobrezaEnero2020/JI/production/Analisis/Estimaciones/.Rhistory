boxplot(wide12$igual~wide12$tratamiento)
# Bases separadas
wide12pob <- dplyr::filter(wide12,Tdes==0)
wide12pob <- dplyr::select(wide12pob,zofamilia2,zhwork2,zdvE2,Tpob,igual)
wide12pob <- na.omit(wide12pob)
summary(wide12pob)
wide12des <- dplyr::filter(wide12,Tpob==0)
wide12des <- dplyr::select(wide12des,zofamilia2,zhwork2,zdvE2,Tdes,igual)
wide12des <- na.omit(wide12des)
inter.raw(Y = "zofamilia2", D = "Tpob", X = "igual", data = wide12pob,
Ylabel = "Outcome", Dlabel = "Treatment", Xlabel="Moderator")
inter.raw(Y = "zofamilia2", D = "Tdes", X = "igual", data = wide12des,
Ylabel = "Outcome", Dlabel = "Treatment", Xlabel="Moderator")
out <- interflex(Y = "zofamilia2", D = "Tpob", X = "igual", data = wide12pob,
estimator = 'binning',vartype = "robust", main = "Marginal Effects")
out$graph
out <- interflex(Y = "zofamilia2", D = "Tdes", X = "igual", data = wide12des,
estimator = 'binning',vartype = "robust", main = "Marginal Effects")
out$graph
out <- interflex(Y = "zhwork2", D = "Tpob", X = "igual", data = wide12pob,
estimator = 'binning',vartype = "robust", main = "Marginal Effects")
out$graph
out <- interflex(Y = "zhwork2", D = "Tdes", X = "igual", data = wide12des,
estimator = 'binning',vartype = "robust", main = "Marginal Effects")
out$graph
out <- interflex(Y = "zdvE2", D = "Tpob", X = "igual", data = wide12pob,
estimator = 'binning',vartype = "robust", main = "Marginal Effects")
out$graph
out <- interflex(Y = "zdvE2", D = "Tdes", X = "igual", data = wide12des,
estimator = 'binning',vartype = "robust", main = "Marginal Effects")
out$graph
out$tests
