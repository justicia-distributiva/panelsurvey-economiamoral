load("/Users/luismaldonado/Dropbox/Sol3026_3063/2020/Clases/Clase 6/Ejemplo/Chaiten.RData")
# Propensity score
fit <- glm(Exposicion~tch + Terciaria,family=binomial(),data=Chaiten)
Chaiten$ps <- predict(fit,type="response")
# IPW
p.fit <-ifelse(Chaiten$Exposicion == 0,
1 - predict(fit, type = "response"),
predict(fit, type = "response"))
Chaiten$w <- 1 / p.fit
# IPW truncado
quantile(Chaiten$w, c(.01,.99))
Chaiten$w_trunc <- Chaiten$w
Chaiten$w_trunc[Chaiten$w_trunc > 28.101261]<- 28.101261
Chaiten$w_trunc[Chaiten$w_trunc < 1.000494]<- 1.000494
# SIPW
fit <- glm(Exposicion~tch + Terciaria,family=binomial(),data=Chaiten)
denom.p <- predict(fit,type="response")
numer.fit <- glm(Exposicion~1, family = binomial(link="logit"), data = Chaiten)
numer.p <- predict(numer.fit, type = "response")
Chaiten$sw <- ifelse(Chaiten$Exposicion == 0, ((1-numer.p)/(1-denom.p)),
(numer.p/denom.p))
# SIPW truncado
quantile(Chaiten$sw, c(.01,.99))
Chaiten$sw_trunc <- Chaiten$sw
Chaiten$sw_trunc[Chaiten$sw_trunc > 7.281298]<- 7.281298
Chaiten$sw_trunc[Chaiten$sw_trunc < 0.335337]<- 0.335337
library(ggplot2)
names(Chaiten)
ggplot(Chaiten,aes(x=factor(Exposicion),y=tch)) + geom_boxplot()
ggplot(Chaiten,aes(x=factor(Exposicion),y=tch),weight=sw_trunc) + geom_boxplot()
ggplot(Chaiten,aes(x=factor(Exposicion),y=tch)) + geom_boxplot()
boxplot(Chaiten$sw_trunc[Chaiten$Exposicion==0],main="Controles") # ps para controles
boxplot(Chaiten$w[Chaiten$Exposicion==1],main="Tratados") # ps para tratados
ggplot(Chaiten,aes(x=factor(Exposicion),y=tch)) + geom_boxplot()
ggplot(Chaiten,aes(x=factor(Exposicion),y=tch,weight=sw_trunc)) + geom_boxplot()
library(ggplot2)
library(grid)
library(gridExtra)
# Box plots
g1 <- ggplot(Chaiten,aes(x=factor(Exposicion),y=tch)) + geom_boxplot()
g2 <- ggplot(Chaiten,aes(x=factor(Exposicion),y=tch,weight=sw_trunc)) + geom_boxplot()
grid.arrange(g1,g2,ncol=2)
g3 <- ggplot(Chaiten,aes(x=factor(Exposicion),y=ps)) + geom_boxplot()
g4 <- ggplot(Chaiten,aes(x=factor(Exposicion),y=ps,weight=sw_trunc)) + geom_boxplot()
grid.arrange(g3,g4,ncol=2)
g1 <- ggplot(Chaiten,aes(x=factor(Exposicion),y=tch)) + geom_boxplot() + ggtitle("Pre")
g2 <- ggplot(Chaiten,aes(x=factor(Exposicion),y=tch,weight=sw_trunc)) + geom_boxplot() + ggtitle("Post")
grid.arrange(g1,g2,ncol=2)
# Terciaria
ggplot(Chaiten,aes(x=Terciaria,fill=Exposicion)) + geom_histogram(position="identity",alpha=0.4)
# Terciaria
ggplot(Chaiten,aes(x=Exposicion,y=Terciaria)) + geom_bar(stat="identity")
# Terciaria
ggplot(Chaiten,aes(x=Exposicion,y=Terciaria)) + geom_bar(stat="identity") + ggtitle("Pre")
# Terciaria
ggplot(Chaiten,aes(x=factor(Exposicion),y=Terciaria)) + geom_bar(stat="identity") + ggtitle("Pre")
ggplot(Chaiten,aes(x=factor(Exposicion),y=Terciaria,weight=sw_trunc)) + geom_bar(stat="identity") + ggtitle("Post")
ggplot(Chaiten,aes(x=factor(Exposicion),y=Terciaria,weight=sw_trunc)) + geom_bar(stat="identity") + ggtitle("Post")
ggplot(Chaiten,aes(x=factor(Exposicion),y=Terciaria,weight=sw_trunc)) + geom_bar(stat="identity") + ggtitle("Post")
