calc.tau.ps = function( Y, Tx, b ) {#
	stopifnot( !is.null(b) & !is.null(Tx) & !is.null(Y))#
	n = length(Y)#
#
	mns = tapply( Y, list( b, Tx ), mean )#
	tx <- sum( (mns[,2] - mns[,1]) * table(b)/n )#
#
	tx#
}
