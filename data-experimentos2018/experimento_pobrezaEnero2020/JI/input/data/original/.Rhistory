prop.table(table(w03c$get_ah_3_w3,exclude=NULL)) # 22 NAs
w03c$get_ah_3_w3a <- w03c$get_ah_3_w3
w03c$get_ah_3_w3a[is.na(w03c$get_ah_3_w3)]=mean(w03c$get_ah_3_w3,na.rm=T)
