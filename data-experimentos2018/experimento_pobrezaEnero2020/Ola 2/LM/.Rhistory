m1 <- lm(Mfamilia ~ factor(tratamiento), data = pilot0819b)
m2 <- lm(MeducacionP ~ factor(tratamiento), data = pilot0819b)
m3 <- lm(Meducacion ~ factor(tratamiento), data = pilot0819b)
m4 <- lm(Mambicion ~ factor(tratamiento), data = pilot0819b)
m5 <- lm(Mtrabajo ~ factor(tratamiento), data = pilot0819b)
m1 <- coeftest(m1,vcovHC(m1, typt="HC2"))
m2 <- coeftest(m2,vcovHC(m2, typt="HC2"))
m3 <- coeftest(m3,vcovHC(m3, typt="HC2"))
m4 <- coeftest(m4,vcovHC(m4, typt="HC2"))
m5 <- coeftest(m5,vcovHC(m5, typt="HC2"))
screenreg(l=list(m1,m2), single.row = TRUE, stars = c(0.01, 0.05, 0.10))
screenreg(l=list(m3,m4,m5), single.row = TRUE, stars = c(0.01, 0.05, 0.10))
